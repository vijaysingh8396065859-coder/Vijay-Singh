rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVE HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isNumber(v) {
      return v is int || v is float;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidDateKey(d) {
      return d is string && d.size() == 10 && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidCustomer(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.address is string && data.address.size() <= 120 &&
             data.milkType is string && data.milkType in ['BUFFALO', 'COW', 'MIXED'] &&
             data.defaultShift is string && data.defaultShift in ['MORNING', 'EVENING', 'BOTH'] &&
             isNumber(data.defaultQtyLiters) && data.defaultQtyLiters >= 0 && data.defaultQtyLiters <= 1000 &&
             isNumber(data.ratePerLiter) && data.ratePerLiter >= 1 && data.ratePerLiter <= 1000 &&
             isNumber(data.openingBalance) && data.openingBalance >= -1000000 && data.openingBalance <= 1000000 &&
             data.active is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidMilkEntry(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             isValidId(data.customerId) &&
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80 &&
             isValidDateKey(data.dateKey) &&
             data.shift is string && data.shift in ['MORNING', 'EVENING'] &&
             data.milkType is string && data.milkType in ['BUFFALO', 'COW', 'MIXED'] &&
             isNumber(data.quantityLiters) && data.quantityLiters >= 0 && data.quantityLiters <= 1000 &&
             isNumber(data.ratePerLiter) && data.ratePerLiter >= 0 && data.ratePerLiter <= 1000 &&
             isNumber(data.totalAmount) && data.totalAmount >= 0 && data.totalAmount <= 1000000 &&
             data.absent is bool &&
             data.note is string && data.note.size() <= 200 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPayment(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             isValidId(data.customerId) &&
             data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80 &&
             isValidDateKey(data.dateKey) &&
             isNumber(data.amount) && data.amount > 0 && data.amount <= 1000000 &&
             data.paymentMode is string && data.paymentMode in ['CASH', 'UPI', 'BANK'] &&
             data.note is string && data.note.size() <= 200 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // --- USER-SCOPED DAIRY COLLECTIONS ---
    match /users/{userId} {
      match /customers/{customerId} {
        allow get: if isOwner(userId) && isValidId(customerId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(customerId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'phone', 'address', 'milkType', 'defaultShift',
                           'defaultQtyLiters', 'ratePerLiter', 'openingBalance', 'active',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'phone', 'address', 'milkType', 'defaultShift',
                           'defaultQtyLiters', 'ratePerLiter', 'openingBalance', 'active',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidCustomer(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(customerId) &&
                         isValidCustomer(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           // Action: Edit customer profile & delivery defaults
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'name', 'phone', 'address', 'milkType', 'defaultShift',
                             'defaultQtyLiters', 'ratePerLiter', 'openingBalance', 'active',
                             'updatedAt'
                           ]) ||
                           // Action: Toggle customer active status
                           incoming().diff(existing()).affectedKeys().hasOnly(['active', 'updatedAt'])
                         );

        allow delete: if isOwner(userId) && isValidId(customerId);
      }

      match /milk_entries/{entryId} {
        allow get: if isOwner(userId) && isValidId(entryId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(entryId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'customerId', 'customerName', 'dateKey', 'shift',
                           'milkType', 'quantityLiters', 'ratePerLiter', 'totalAmount',
                           'absent', 'note', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'customerId', 'customerName', 'dateKey', 'shift',
                           'milkType', 'quantityLiters', 'ratePerLiter', 'totalAmount',
                           'absent', 'note', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidMilkEntry(incoming()) &&
                         exists(/databases/$(database)/documents/users/$(userId)/customers/$(incoming().customerId));

        allow update: if isOwner(userId) &&
                         isValidId(entryId) &&
                         isValidMilkEntry(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().customerId == existing().customerId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           // Action: Edit delivery entry
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'customerName', 'dateKey', 'shift', 'milkType',
                             'quantityLiters', 'ratePerLiter', 'totalAmount',
                             'absent', 'note', 'updatedAt'
                           ]) ||
                           // Action: Mark absent or adjust quantity
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'quantityLiters', 'totalAmount', 'absent', 'updatedAt'
                           ])
                         );

        allow delete: if isOwner(userId) && isValidId(entryId);
      }

      match /payments/{paymentId} {
        allow get: if isOwner(userId) && isValidId(paymentId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(paymentId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'customerId', 'customerName', 'dateKey',
                           'amount', 'paymentMode', 'note', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'customerId', 'customerName', 'dateKey',
                           'amount', 'paymentMode', 'note', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidPayment(incoming()) &&
                         exists(/databases/$(database)/documents/users/$(userId)/customers/$(incoming().customerId));

        allow update: if isOwner(userId) &&
                         isValidId(paymentId) &&
                         isValidPayment(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().customerId == existing().customerId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           // Action: Edit payment details
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'customerName', 'dateKey', 'amount', 'paymentMode', 'note', 'updatedAt'
                           ])
                         );

        allow delete: if isOwner(userId) && isValidId(paymentId);
      }
    }
  }
}
